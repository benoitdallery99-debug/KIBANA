<!DOCTYPE html>
<html lang="fr" {% if theme_force %}data-theme="{{ theme_force }}"{% endif %}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ titre }}</title>
<meta name="description" content="{{ sous_titre }}">
<meta name="generator" content="kit de formation Kibana pour analystes SOC">
<style>{{ css | safe }}</style>
</head>
<body>
<!-- Lien d'évitement : premier élément focalisable de la page, il permet de
     sauter le sommaire, qui compte une cinquantaine de liens. Sans lui, un
     utilisateur au clavier les traverse tous avant d'atteindre le contenu, à
     chaque changement de page. Visible seulement quand il a le focus. -->
<a class="evitement" href="#contenu">Aller au contenu</a>
<div class="ossature">

<nav class="sommaire" aria-label="Sommaire du guide" data-ouvert="oui">
  <button class="bouton sommaire__bascule" id="bascule-sommaire" aria-expanded="true"
          aria-controls="sommaire-corps">Sommaire</button>
  <div class="sommaire__corps" id="sommaire-corps">
    <p class="sommaire__titre">Parcours</p>
    <ol>
      <li class="sommaire__module">
        <a href="#contexte"><span>Contexte</span></a>
      </li>
      {% for m in modules %}
      <li class="sommaire__module">
        <a href="#{{ m.ancre }}">
          <span>{{ m.id }} — {{ m.titre }}</span>
          <span class="sommaire__jauge" data-jauge-module="{{ m.id }}" aria-live="off">—</span>
        </a>
        <div class="sommaire__exercices">
          {% for e in m.exercices %}
          <a href="#{{ e.ancre }}">{{ e.id }} · {{ e.titre }}</a>
          {% endfor %}
        </div>
      </li>
      {% endfor %}
      {% if quiz %}
      <li class="sommaire__module">
        <a href="#quiz">
          <span>Quiz</span>
          <span class="sommaire__jauge" data-jauge-quiz>—</span>
        </a>
      </li>
      {% endif %}
      <li class="sommaire__module"><a href="#glossaire"><span>Glossaire</span></a></li>
    </ol>

    <div class="enquete">
      <p class="sommaire__titre">Enquête</p>
      <div class="enquete__liste">
        {% for s in scenarios %}
        <span class="enquete__case" data-enquete="{{ s }}" data-resolu="non"
              title="Scénario {{ s }}">{{ s }}</span>
        {% endfor %}
      </div>
    </div>
  </div>
</nav>

<main class="contenu" id="contenu" tabindex="-1">
  <div class="outils">
    <span class="recherche">
      <label class="visuellement-cache" for="recherche">Rechercher dans le guide</label>
      <input type="search" id="recherche" placeholder="Rechercher dans le guide…">
    </span>
    <span class="recherche__resultats" id="recherche-resultats" role="status"
          aria-live="polite"></span>
    <button class="bouton" id="bascule-theme" type="button">Thème sombre</button>
  </div>

  <header class="colonne">
    <h1>{{ titre }}</h1>
    <p class="module__resume">{{ sous_titre }}</p>
    <p class="module__meta">Elastic Stack {{ version }} · licence {{ licence }} ·
      interface {{ locale }} · {{ duree_totale }} minutes</p>
  </header>

  <section id="contexte" data-ancre data-cherchable class="colonne">
    <h2>Le contexte de l'enquête</h2>
    <p>Vous rejoignez le SOC de <strong>{{ contexte.organisation }}</strong>. Voici ce
      qu'un analyste de permanence a sous les yeux. Gardez cette fiche ouverte :
      elle contient au moins une clé dont vous aurez besoin.</p>
    <p class="module__meta">{{ contexte.avertissement }}</p>

    <h3>Le plan d'adressage</h3>
    <table>
      <thead><tr><th>Réseau</th><th>Plage</th><th>Rôle</th></tr></thead>
      <tbody>
      {% for nom, r in contexte.sous_reseaux.items() %}
        <tr><td>{{ nom }}</td><td><code>{{ r.cidr }}</code></td><td>{{ r.role }}</td></tr>
      {% endfor %}
      </tbody>
    </table>

    <h3>Les serveurs critiques</h3>
    <table>
      <thead><tr><th>Machine</th><th>Adresse</th><th>Rôle</th></tr></thead>
      <tbody>
      {% for h in contexte.hotes if h.critique %}
        <tr><td><code>{{ h.nom }}</code></td><td><code>{{ h.ip }}</code></td>
            <td>{{ h.role }}</td></tr>
      {% endfor %}
      </tbody>
    </table>

    <h3>Les comptes de service</h3>
    <table>
      <thead><tr><th>Compte</th><th>Rôle</th></tr></thead>
      <tbody>
      {% for c in contexte.comptes_de_service %}
        <tr><td><code>{{ c.nom }}</code></td><td>{{ c.role }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    {# Le décompte exact des machines a été retiré : il vaut 21, soit
       exactement R.nb_hotes, la réponse attendue de M2-E4, M3-E4 et M5-E3.
       SPEC §5.4 énumère ce que cette fiche publie — organisation, plan
       d'adressage, serveurs critiques, comptes de service, adresse du
       scanner — et la taille du parc n'y figure pas. Le nombre de comptes,
       lui, n'est la réponse de rien et reste utile à l'enquête. #}
    <p>L'organisation compte {{ contexte.nombre_de_comptes }} comptes. Le
      nombre exact de machines qui remontent des journaux ne vous est pas
      donné : c'est une chose que l'on établit soi-même, et vous le ferez.</p>

    <h3>Les activités autorisées</h3>
    <p>Certaines activités bruyantes sont <strong>connues et autorisées</strong>. Les
      confondre avec une attaque coûte une nuit de travail à tout le monde.</p>
    <table>
      <thead><tr><th>Machine</th><th>Adresse</th><th>Ce qu'elle fait</th></tr></thead>
      <tbody>
        <tr>
          <td><code>{{ contexte.scanner_autorise.nom }}</code></td>
          <td><code>{{ contexte.scanner_autorise.ip }}</code></td>
          <td>{{ contexte.scanner_autorise.role }} — {{ contexte.scanner_autorise.fenetre }}.
              Contact : {{ contexte.scanner_autorise.contact }}.</td>
        </tr>
      </tbody>
    </table>
  </section>

  {% for m in modules %}
  <section id="{{ m.ancre }}" data-ancre data-cherchable>
    <div class="colonne">
      <h2>{{ m.id }} — {{ m.titre }}</h2>
      <p class="module__resume">{{ m.resume }}</p>
      <p class="module__meta">{{ m.duree_minutes }} minutes ·
        {{ m.exercices | length }} exercice{{ "s" if m.exercices | length > 1 }}</p>

      <h3>Ce que vous saurez faire</h3>
      <ul>
        {% for o in m.objectifs %}<li>{{ o.enonce }}</li>{% endfor %}
      </ul>

      {% if m.rappel_actif %}
      <h3>Avant de commencer — de mémoire</h3>
      <p>Répondez sans revenir en arrière. Si une réponse ne vient pas, c'est le
        moment de relire, pas pendant l'exercice.</p>
      {% for r in m.rappel_actif %}
      <details>
        <summary>{{ r.question | safe }}</summary>
        <div>{{ r.reponse | safe }}</div>
      </details>
      {% endfor %}
      {% endif %}

    </div>

    {# Le corps du module sort du « .colonne » parce qu'il porte maintenant des
       figures, appelées par le texte à l'endroit qu'elles illustrent. Le CSS
       rend la colonne de lecture à tout ce qui n'est pas une figure ; les
       figures, elles, prennent la largeur du contenu. #}
    <div class="colonne colonne--figures">
      {{ m.corps_html | safe }}
    </div>

    {# Les captures sortent de la colonne de lecture. Mesurée à 1 440 px, une
       capture de 1 600 px logiques s'y rendait à 749 px : ni les noms de
       champs, ni la barre de requête, ni le compteur de documents n'y étaient
       lisibles — c'est-à-dire exactement ce que les légendes demandent de
       regarder. Hors du « .colonne », la figure prend toute la largeur du
       contenu ; la légende, elle, reste bornée à la colonne par le CSS. #}
    {% for c in m.captures %}
    <figure id="fig-{{ c.id }}" data-capture="{{ c.id }}">
      <img src="{{ c.source }}" alt="{{ c.alt }}" loading="lazy">
      <figcaption>
        <strong>{{ c.id }}</strong> — {{ c.titre }}. {{ c.legende }}
        {% if c.reperes %}
        <br>{% for r in c.reperes %}<span>{{ loop.index }} · {{ r.note }}{% if not loop.last %} · {% endif %}</span>{% endfor %}
        {% endif %}
      </figcaption>
    </figure>
    {% endfor %}

    {% for e in m.exercices %}
    <article class="exercice" id="{{ e.ancre }}" data-ancre data-cherchable>
      <div class="colonne">
        <div class="exercice__entete">
          <span class="exercice__id">{{ e.id }}</span>
          <h3 style="margin:0">{{ e.titre }}</h3>
          <span class="exercice__guidage">{{ e.guidage_libelle }}</span>
          <span class="exercice__guidage">{{ e.duree_minutes }} min</span>
        </div>

        <p class="exercice__contexte">{{ e.contexte | safe }}</p>

        {% if e.consignes %}
        <div class="action">
          <span class="action__etiquette">DANS KIBANA</span>
          <ol>{% for c in e.consignes %}<li>{{ c | safe }}</li>{% endfor %}</ol>
        </div>
        {% endif %}

        {% for q in e.requetes %}
        <div class="requete">
          <div class="requete__entete">
            <span>{{ q.langage }}</span>
            <button class="bouton" type="button" data-copier="{{ q.id }}">Copier</button>
          </div>
          <pre id="{{ q.id }}" tabindex="0"><code>{{ q.texte }}</code></pre>
        </div>
        {% endfor %}

        {% for i in e.indices %}
        <details>
          <summary>Indice {{ loop.index }}</summary>
          <div>{{ i | safe }}</div>
        </details>
        {% endfor %}

        {% if e.reponse %}
        <div class="reponse" data-exercice="{{ e.id }}" data-module="{{ m.id }}"
             data-scenario="{{ e.reponse.scenario_public }}"
             data-normalisation="{{ e.reponse.normalisation }}"
             data-empreintes="{{ e.reponse.empreintes | join(',') }}">
          <label class="reponse__format" for="rep-{{ e.id }}">
            Votre réponse — {{ e.format_de_reponse | safe }}
          </label>
          <div class="reponse__ligne">
            <input type="text" id="rep-{{ e.id }}" autocomplete="off" spellcheck="false">
            <button class="bouton" type="button" data-verifier>Vérifier ma réponse</button>
          </div>
          <p class="reponse__retour" role="status" aria-live="polite"></p>
        </div>
        {% elif e.rendu %}
        {# Trois exercices du capstone ne se valident pas par une valeur : on y
           construit un écran, ou on y rédige cinq lignes. Leur rendu est décrit
           ici, avec la façon dont il est jugé — c'est ce qui remplace le champ
           de réponse, et non son absence. #}
        <div class="reponse reponse--rendu">
          <p class="reponse__format"><strong>Ce que vous rendez</strong></p>
          <p>{{ e.rendu | safe }}</p>
        </div>
        {% endif %}

        {% if e.solution %}
        {# « data-solution » : ce repli-ci ne s'ouvre pas à l'impression. Le
           correctif qui ouvrait tous les <details> avant le tirage — parce que
           les indices s'imprimaient vides — publiait du même coup les
           trente-cinq démarches en regard de leur exercice. Sur papier, le
           stagiaire n'a plus le choix de ne pas regarder. #}
        <details data-solution>
          <summary>Voir la démarche</summary>
          <div>
            {# Le piège se lit APRÈS coup. Annoncé avant l'action, il désamorce
               l'exercice : le stagiaire évite l'erreur sans l'avoir commise, et
               n'en garde donc rien. #}
            {% if e.piege %}
            <div class="piege">
              <span class="piege__titre">Le piège : {{ e.piege.titre }}</span>
              <p>{{ e.piege.lecon }}</p>
            </div>
            {% endif %}
            <p>{{ e.solution | safe }}</p>
            {% if e.erreurs_typiques %}
            <p><strong>Erreurs fréquentes à ce point</strong></p>
            <ul>{% for x in e.erreurs_typiques %}<li>{{ x | safe }}</li>{% endfor %}</ul>
            {% endif %}
          </div>
        </details>
        {% endif %}

        {% if e.doc %}
        <p class="module__meta"><a href="{{ e.doc }}">Documentation Elastic sur ce point</a></p>
        {% endif %}
      </div>
    </article>
    {% endfor %}
  </section>
  {% endfor %}

  {% if quiz %}
  <section id="quiz" data-ancre data-cherchable class="colonne">
    <h2>Quiz — {{ quiz | length }} questions</h2>
    <p>Répondez sans revenir en arrière. Chaque réponse est expliquée une fois
      que vous avez choisi : c'est l'explication qui compte, pas le score.</p>
    {% for q in quiz %}
    <article class="exercice" id="quiz-{{ q.id }}">
      <div class="exercice__entete">
        <span class="exercice__id">{{ q.id }}</span>
        <h3 style="margin:0">{{ q.question | safe }}</h3>
      </div>
      <div class="quiz" data-quiz="{{ q.id }}" data-bonne="{{ q.reponse }}">
        <fieldset style="border:0;padding:0;margin:0.6rem 0">
          <legend class="visuellement-cache">{{ q.question | safe }}</legend>
          {% for p in q.propositions %}
          <label style="display:block;margin:0.3rem 0">
            <input type="radio" name="quiz-{{ q.id }}" value="{{ loop.index0 }}">
            {{ p | safe }}
          </label>
          {% endfor %}
        </fieldset>
        <button class="bouton" type="button" data-repondre>Vérifier ma réponse</button>
        <p class="reponse__retour" role="status" aria-live="polite"></p>
        <div class="quiz__explication" hidden>
          <p>{{ q.explication | safe }}</p>
        </div>
      </div>
    </article>
    {% endfor %}
  </section>
  {% endif %}

  <section id="glossaire" data-ancre data-cherchable class="colonne">
    <h2>Glossaire</h2>
    <dl>
      {% for t in glossaire %}
      <dt><strong>{{ t.terme }}</strong></dt>
      <dd>{{ t.definition }}</dd>
      {% endfor %}
    </dl>
  </section>

  <footer class="colonne module__meta">
    <p>{{ avertissement_donnees }}</p>
  </footer>
</main>
</div>
<script>{{ js | safe }}</script>
</body>
</html>
