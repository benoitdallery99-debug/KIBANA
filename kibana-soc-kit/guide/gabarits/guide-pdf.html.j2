<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>{{ titre }}</title>
<style>{{ css_polices }}</style>
<style>{{ css }}</style>
</head>
<body>

<section class="titre-page">
  <h1>{{ titre }}</h1>
  <p class="sous-titre">{{ sous_titre }}</p>
  <p class="meta">
    Elastic Stack {{ version }} · licence {{ licence }} · interface {{ locale }}<br>
    {{ modules | length }} modules · {{ duree_totale }} minutes ·
    {{ nb_exercices }} exercices
  </p>
  <p class="avertissement">{{ avertissement_donnees }}</p>
</section>

<section class="sommaire-pdf">
  <h2>Sommaire</h2>
  <ol>
    <li><a href="#contexte">Le contexte de l'enquête</a></li>
    {% for m in modules %}
    <li><a href="#{{ m.ancre }}">{{ m.id }} — {{ m.titre }}</a></li>
    {% for e in m.exercices %}
    <li class="niveau-2"><a href="#{{ e.ancre }}">{{ e.id }} · {{ e.titre }}</a></li>
    {% endfor %}
    {% endfor %}
    <li><a href="#glossaire">Glossaire</a></li>
    <li><a href="#annexe-solutions">Annexe — démarches et solutions</a></li>
  </ol>
</section>

<section id="contexte">
  <h2>Le contexte de l'enquête</h2>
  <p>Vous rejoignez le SOC de <strong>{{ contexte.organisation }}</strong>. Gardez
    cette fiche sous les yeux : elle contient au moins une clé dont vous aurez besoin.</p>

  <h3>Plan d'adressage</h3>
  <table>
    <thead><tr><th>Réseau</th><th>Plage</th><th>Rôle</th></tr></thead>
    <tbody>{% for nom, r in contexte.sous_reseaux.items() %}
      <tr><td>{{ nom }}</td><td><code>{{ r.cidr }}</code></td><td>{{ r.role }}</td></tr>
    {% endfor %}</tbody>
  </table>

  <h3>Serveurs critiques</h3>
  <table>
    <thead><tr><th>Machine</th><th>Adresse</th><th>Rôle</th></tr></thead>
    <tbody>{% for h in contexte.hotes if h.critique %}
      <tr><td><code>{{ h.nom }}</code></td><td><code>{{ h.ip }}</code></td><td>{{ h.role }}</td></tr>
    {% endfor %}</tbody>
  </table>

  <h3>Comptes de service</h3>
  <table>
    <thead><tr><th>Compte</th><th>Rôle</th></tr></thead>
    <tbody>{% for c in contexte.comptes_de_service %}
      <tr><td><code>{{ c.nom }}</code></td><td>{{ c.role }}</td></tr>
    {% endfor %}</tbody>
  </table>

  <h3>Activités autorisées</h3>
  <table>
    <thead><tr><th>Machine</th><th>Adresse</th><th>Ce qu'elle fait</th></tr></thead>
    <tbody><tr>
      <td><code>{{ contexte.scanner_autorise.nom }}</code></td>
      <td><code>{{ contexte.scanner_autorise.ip }}</code></td>
      <td>{{ contexte.scanner_autorise.role }} — {{ contexte.scanner_autorise.fenetre }}.</td>
    </tr></tbody>
  </table>
</section>

{% for m in modules %}
<section id="{{ m.ancre }}">
  <h2>{{ m.id }} — {{ m.titre }}</h2>
  <p>{{ m.resume }}</p>
  <p class="lien-doc">{{ m.duree_minutes }} minutes · {{ m.exercices | length }} exercice(s)</p>

  <h3>Ce que vous saurez faire</h3>
  <ul>{% for o in m.objectifs %}<li>{{ o.enonce }}</li>{% endfor %}</ul>

  {% if m.rappel_actif %}
  <h3>Avant de commencer — de mémoire</h3>
  <ul>{% for r in m.rappel_actif %}<li>{{ r.question }}</li>{% endfor %}</ul>
  {% endif %}

  {{ m.corps_html }}

  {% for e in m.exercices %}
  <div class="exercice" id="{{ e.ancre }}">
    <p class="exercice__entete">
      <span class="exercice__id">{{ e.id }}</span> — {{ e.titre }}
      <span class="exercice__id">({{ e.guidage_libelle }}, {{ e.duree_minutes }} min)</span>
    </p>
    <p class="exercice__contexte">{{ e.contexte }}</p>

    {% if e.consignes %}
    <div class="action">
      <span class="action__etiquette">DANS KIBANA</span>
      <ol>{% for c in e.consignes %}<li>{{ c }}</li>{% endfor %}</ol>
    </div>
    {% endif %}

    {% for q in e.requetes %}
    <pre>{{ q.texte }}</pre>
    {% endfor %}

    {% if e.piege %}
    <div class="piege">
      <span class="piege__titre">Le piège : {{ e.piege.titre }}</span>
      {{ e.piege.lecon }}
    </div>
    {% endif %}

    {% if e.indices %}
    <p><strong>Indices</strong></p>
    <ol>{% for i in e.indices %}<li>{{ i }}</li>{% endfor %}</ol>
    {% endif %}

    {% if e.reponse %}
    <p class="champ-reponse__libelle">Votre réponse — {{ e.format_de_reponse }}</p>
    <div class="champ-reponse"></div>
    {% endif %}
    {% if e.doc %}<p class="lien-doc">{{ e.doc }}</p>{% endif %}
  </div>
  {% endfor %}
</section>
{% endfor %}

<section id="glossaire">
  <h2>Glossaire</h2>
  <table>
    <thead><tr><th>Terme</th><th>Définition</th></tr></thead>
    <tbody>{% for t in glossaire %}
      <tr><td><strong>{{ t.terme }}</strong></td><td>{{ t.definition }}</td></tr>
    {% endfor %}</tbody>
  </table>
</section>

<section id="annexe-solutions" class="annexe">
  <h2>Annexe — démarches et solutions</h2>
  <p>Les exercices du corps du document ne portent pas leur solution : on ne
    cherche pas sérieusement une réponse qu'on a sous les yeux. Elles sont ici.</p>
  {% for m in modules %}
  <h3>{{ m.id }} — {{ m.titre }}</h3>
  {% for e in m.exercices if e.solution %}
  <div class="exercice">
    <p class="exercice__entete"><span class="exercice__id">{{ e.id }}</span> — {{ e.titre }}</p>
    <p>{{ e.solution }}</p>
    {% if e.erreurs_typiques %}
    <p><strong>Erreurs fréquentes</strong></p>
    <ul>{% for x in e.erreurs_typiques %}<li>{{ x }}</li>{% endfor %}</ul>
    {% endif %}
  </div>
  {% endfor %}
  {% endfor %}
</section>

</body>
</html>
